// ============================================================
// tangnano9k.cst - Gowin fiziksel kisit (pin) dosyasi
// Board: Sipeed Tang Nano 9K (GW1NR-LV9QN88PC6)
// ============================================================
// Pin numaralari Sipeed resmi dokumantasyonundan alinmistir.
// (clk=52, LED=10..16, S1=3, S2=4, UART_TX=17, UART_RX=18)

// 27 MHz onboard saat
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 6 LED (aktif dusuk)
IO_LOC  "led[0]" 10;
IO_LOC  "led[1]" 11;
IO_LOC  "led[2]" 13;
IO_LOC  "led[3]" 14;
IO_LOC  "led[4]" 15;
IO_LOC  "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// Kullanici butonu S1 (pin 3, 1.8V bank -> LVCMOS18, active-low, 10K pull-up)
// S2 (pin 4) kullanilmiyor (JTAG ile paylasimli). Butonun okunmasi icin sentezde
// nextpnr'a --vopt disable_gp_clock_routing verilmeli (bkz. build_oss.sh).
IO_LOC  "btn1" 3;
IO_PORT "btn1" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// UART (onboard BL702 USB-UART kopru)
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
